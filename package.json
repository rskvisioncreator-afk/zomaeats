{
  "name": "zomato-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Zomato-inspired food delivery app built with React, TypeScript, Vite and Firebase",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "seed": "node scripts/build-seed.mjs",
    "fetch-images": "node scripts/fetch-images.mjs",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "firebase-tools": "^15.37.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
